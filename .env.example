
# App
APP_ENV=local
APP_TIMEZONE=Europe/Berlin

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Database (Postgres)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/memory_assistant

# Notion (optional)
NOTION_TOKEN=
NOTION_TASKS_DB_ID=
NOTION_NOTES_DB_ID=

# LLM (text reasoning) - we will fill only if we use a cloud LLM otherwise it will be secret
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Local ASR (no voice to cloud) = if we use this ASM 
ASR_MODEL=small